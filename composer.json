{
    "name": "velirapay/velirapay-laravel",
    "description": "VeliraPay for Laravel: a configured API client, a facade, and verified webhooks dispatched as Laravel events.",
    "type": "library",
    "keywords": [
        "velirapay",
        "laravel",
        "crypto",
        "payments",
        "payment-gateway",
        "bitcoin",
        "ethereum",
        "webhooks"
    ],
    "homepage": "https://velirapay.com",
    "license": "MIT",
    "authors": [
        {
            "name": "VeliraPay",
            "homepage": "https://velirapay.com"
        }
    ],
    "support": {
        "docs": "https://velirapay.com/docs",
        "issues": "https://github.com/VeliraPay/velirapay-laravel/issues",
        "source": "https://github.com/VeliraPay/velirapay-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "velirapay/velirapay-php": "^0.1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.3 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "VeliraPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeliraPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VeliraPay\\Laravel\\VeliraPayServiceProvider"
            ],
            "aliases": {
                "VeliraPay": "VeliraPay\\Laravel\\Facades\\VeliraPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "types": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@types",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
