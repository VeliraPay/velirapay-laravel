{
    "name": "velirapay/velirapay-laravel",
    "description": "The official Laravel package for VeliraPay crypto payments: the API client configured from .env behind a facade, verified webhooks dispatched as Laravel events, and helpers to test both.",
    "type": "library",
    "keywords": [
        "velirapay",
        "laravel",
        "laravel-package",
        "crypto",
        "cryptocurrency",
        "crypto-payments",
        "payments",
        "payment-gateway",
        "payment-processing",
        "bitcoin",
        "lightning",
        "ethereum",
        "litecoin",
        "solana",
        "tron",
        "usdt",
        "usdc",
        "stablecoin",
        "webhooks",
        "sdk",
        "api",
        "api-client"
    ],
    "homepage": "https://velirapay.com",
    "license": "MIT",
    "authors": [
        {
            "name": "VeliraPay",
            "homepage": "https://velirapay.com"
        }
    ],
    "support": {
        "docs": "https://velirapay.com/docs/libraries",
        "issues": "https://github.com/VeliraPay/velirapay-laravel/issues",
        "source": "https://github.com/VeliraPay/velirapay-laravel",
        "security": "https://github.com/VeliraPay/velirapay-laravel/security/policy"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/psr7": "^2.0 || ^3.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "velirapay/velirapay-php": "^0.6.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.3 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "VeliraPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VeliraPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VeliraPay\\Laravel\\VeliraPayServiceProvider"
            ],
            "aliases": {
                "VeliraPay": "VeliraPay\\Laravel\\Facades\\VeliraPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test",
        "types": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@types",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
